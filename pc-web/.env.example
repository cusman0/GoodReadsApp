# Vite Web App Environment Configuration (.env.example)
# Copy to pc-web/.env or root .env
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Gemini & Other API Keys
VITE_GEMINI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_WEB_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=your_firebase_app_check_debug_token

