# ==============================================================================
# GOODREADS APP WITH AI INTEGRATION - CONFIGURATION TEMPLATE
# Follows specifications in prompt_requirements.md & FIREBASE_SETUP.md
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE CONFIGURATION (Free Spark Plan)
# ------------------------------------------------------------------------------
# Obtain these from: Firebase Console > Project Settings > General > Your apps > Web app (</>)
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_web_app_id
FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ------------------------------------------------------------------------------
# 2. GOOGLE AUTHENTICATION FOR FIREBASE
# ------------------------------------------------------------------------------
# How to get your Web Client ID:
# 1. Go to Firebase Console -> Build -> Authentication -> Sign-in method -> Google.
# 2. Expand "Web SDK configuration".
# 3. Copy the "Web client ID" (typically: <project-number>-xxxxxxxxxx.apps.googleusercontent.com).
#
# NOTE: In React Native (@react-native-google-signin/google-signin), the 'webClientId'
# is MANDATORY (even on Android) to generate the idToken required by Firebase Auth:
# auth().signInWithCredential(auth.GoogleAuthProvider.credential(idToken))

GOOGLE_WEB_CLIENT_ID=your_project_number-your_web_client_id.apps.googleusercontent.com
VITE_GOOGLE_WEB_CLIENT_ID=your_project_number-your_web_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# Android & iOS OAuth Client IDs (from Google Cloud Console > Credentials)
GOOGLE_ANDROID_CLIENT_ID=your_project_number-your_android_client_id.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=your_project_number-your_ios_client_id.apps.googleusercontent.com

# Firebase OAuth Redirect URI (Authorized redirect URIs in Google Cloud Console)
GOOGLE_AUTH_REDIRECT_URI=https://your-project-id.firebaseapp.com/__/auth/handler

# Scopes requested during Google Sign-In
GOOGLE_SIGN_IN_SCOPES=profile,email,openid

# ------------------------------------------------------------------------------
# 3. VITE WEB CONFIGURATION (Required for Vite client-side bundle in pc-web/ or admin-web/)
# Vite requires VITE_ prefix to expose variables to client code (import.meta.env)
# ------------------------------------------------------------------------------
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=1:your_messaging_sender_id:web:your_web_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ------------------------------------------------------------------------------
# 4. GOOGLE GEMINI AI CONFIGURATION (Goodreads AI Features)
# Used for:
#   - Mobile & Web: AI Book Recommendations & Personalized Reading Insights
#   - Mobile & Web: AI Community Review Summaries & Discussion Helper
#   - Mobile: AI Reading Assistant (Book Q&A, Synopsis & Character Guide)
#   - Mobile: AI Writing Helper (Review Polisher, Quote Extractor)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_AI_API_KEY=your_gemini_api_key_here
VITE_GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
# AI Safeguards & Rate limiting
AI_REQUEST_COOLDOWN_MS=3000
AI_MAX_MESSAGES_CONTEXT=20

# ------------------------------------------------------------------------------
# 5. FIREBASE APP CHECK CONFIGURATION
# Initialized with Debug Provider (@react-native-firebase/app-check & web)
# Obtain debug token from: Firebase Console > App Check > Apps > Manage debug tokens
# ------------------------------------------------------------------------------
FIREBASE_APP_CHECK_DEBUG_TOKEN=your_firebase_app_check_debug_token
VITE_FIREBASE_APP_CHECK_DEBUG_TOKEN=your_firebase_app_check_debug_token
RECAPTCHA_SITE_KEY=your_recaptcha_enterprise_site_key

# ------------------------------------------------------------------------------
# 6. GOODREADS APP CONFIGURATION
# ------------------------------------------------------------------------------
DEFAULT_SHELF=want-to-read
DEFAULT_READING_CHALLENGE_GOAL=20
APP_ENV=development
