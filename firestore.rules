rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isReviewOwner(data) {
      return isSignedIn() && (
        (data.ownerId != null && request.auth.uid == data.ownerId) ||
        (data.authorId != null && request.auth.uid == data.authorId)
      );
    }

    function isParentReviewPublic(reviewId) {
      return get(/databases/$(database)/documents/reviews/$(reviewId)).data.visibility == 'public';
    }

    function isParentReviewOwner(reviewId) {
      return isSignedIn() && isReviewOwner(get(/databases/$(database)/documents/reviews/$(reviewId)).data);
    }

    // 1. Users collection
    // Read by anyone; written only by the user
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isUser(uid);
      allow delete: if false;

      // User Shelved Books subcollection
      match /shelvedBooks/{bookId} {
        allow read: if isSignedIn();
        allow write: if isUser(uid);
      }
    }

    // 2. Reviews collection
    // Read allowed if visibility is "public" or user is the owner
    // Create, edit, delete allowed for the owner
    match /reviews/{reviewId} {
      allow read: if resource.data.visibility == 'public' || isReviewOwner(resource.data);
      allow create: if isSignedIn()
                    && (request.auth.uid == request.resource.data.ownerId || request.auth.uid == request.resource.data.authorId);
      allow update: if isReviewOwner(resource.data);
      allow delete: if isReviewOwner(resource.data);

      // 2a. Likes subcollection
      match /likes/{uid} {
        allow read: if isParentReviewPublic(reviewId) || isParentReviewOwner(reviewId);
        allow create: if isUser(uid) && isParentReviewPublic(reviewId);
        allow delete: if isUser(uid);
        allow update: if false;
      }

      // 2b. Comments subcollection
      match /comments/{commentId} {
        allow read: if isParentReviewPublic(reviewId) || isParentReviewOwner(reviewId);
        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.userId
                      && isParentReviewPublic(reviewId);
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isParentReviewOwner(reviewId));
        allow update: if false;
      }
    }

    // 3. Books collection
    match /books/{bookId} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/books/$(bookId));
      allow update, delete: if false;
    }

    // 4. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Backward-compatibility: posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isReviewOwner(resource.data)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['visibility']));
      allow delete: if isReviewOwner(resource.data);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.authorId || isReviewOwner(get(/databases/$(database)/documents/posts/$(postId)).data));
        allow update: if false;
      }
    }
  }
}
