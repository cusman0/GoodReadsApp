rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isParentReviewPublic(reviewId) {
      return get(/databases/$(database)/documents/reviews/$(reviewId)).data.visibility == 'public';
    }

    function isParentReviewOwner(reviewId) {
      return isSignedIn() && get(/databases/$(database)/documents/reviews/$(reviewId)).data.ownerId == request.auth.uid;
    }

    // 1. Users collection
    // Read by anyone; written only by the user
    match /users/{uid} {
      allow read: if true;
      allow create, update: if isUser(uid);
      allow delete: if false;

      // User Shelved Books subcollection
      match /shelvedBooks/{bookId} {
        allow read: if isSignedIn();
        allow write: if isUser(uid);
      }
    }

    // 2. Reviews collection
    // Read allowed only if visibility is "public" or user is the owner
    // Create, edit, delete allowed only for the owner
    match /reviews/{reviewId} {
      allow read: if resource.data.visibility == 'public' || isUser(resource.data.ownerId);
      allow create: if isSignedIn()
                    && request.auth.uid == request.resource.data.ownerId
                    && (request.resource.data.visibility == 'public' || request.resource.data.visibility == 'private');
      allow update: if isUser(resource.data.ownerId)
                    && (request.resource.data.visibility == 'public' || request.resource.data.visibility == 'private');
      allow delete: if isUser(resource.data.ownerId);

      // 2a. Likes subcollection
      // Document ID is the user's uid
      match /likes/{uid} {
        allow read: if isParentReviewPublic(reviewId) || isParentReviewOwner(reviewId);
        allow create: if isUser(uid) && isParentReviewPublic(reviewId);
        allow delete: if isUser(uid);
        allow update: if false;
      }

      // 2b. Comments subcollection
      match /comments/{commentId} {
        allow read: if isParentReviewPublic(reviewId) || isParentReviewOwner(reviewId);
        allow create: if isSignedIn()
                      && request.auth.uid == request.resource.data.userId
                      && isParentReviewPublic(reviewId);
        allow delete: if isSignedIn() && (request.auth.uid == resource.data.userId || isParentReviewOwner(reviewId));
        allow update: if false;
      }
    }

    // 3. Books collection
    // Anyone can read. A signed-in user can create only if it does not exist yet.
    match /books/{bookId} {
      allow read: if true;
      allow create: if isSignedIn() && !exists(/databases/$(database)/documents/books/$(bookId));
      allow update, delete: if false;
    }

    // 4. Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.senderId;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // Backward-compatibility: posts collection
    match /posts/{postId} {
      allow read: if true;
      allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
      allow update: if isUser(resource.data.authorId)
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']))
                    || (isSignedIn() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentsCount']));
      allow delete: if isUser(resource.data.authorId);

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isSignedIn() && request.auth.uid == request.resource.data.authorId;
        allow delete: if isSignedIn() && request.auth.uid == resource.data.authorId;
        allow update: if false;
      }
    }
  }
}
